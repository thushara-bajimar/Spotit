# Copy this file to server/.env and adjust as needed.
# Never commit the real .env file.

NODE_ENV=development
PORT=4000

# SQLite file, relative to the server/ folder
DATABASE_PATH=data/spotit.db

# Browser origins allowed to send POST/PATCH/DELETE requests (comma-separated).
# The defaults cover the Vite dev server (5173) and `vite preview` (4173).
# CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173

# First admin account — used only by `npm run create-admin` (development tool).
# Phone: 10-digit Indian mobile number. Password: at least 8 characters.
# Remove ADMIN_PASSWORD from this file after the admin has been created.
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_PASSWORD=
